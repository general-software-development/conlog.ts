{
  "name": "conlog.ts",
  "version": "1.1.0",
  "type": "module",
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "scripts": {
    "build": "cd src && bun build ./* --minify --outdir ../dist/conlog --metafile --metafile-md --no-bundle"
  },
