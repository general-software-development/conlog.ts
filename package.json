
{
  "name": "conlog.ts",
  "version": "1.1.5",
  "type": "module",
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "scripts": {
    "build": "cd src && bun build ./* --minify --outdir ../dist/conlog --metafile --metafile-md --no-bundle",
    "build:types": "tsc --project tsconfig.json",
    "prepack": "npm run build"
  },
  "dependencies": {
    "console-log-colors": "^0.5.0"
  },
  "main": "./dist/conlog/index.js",
  "module": "./dist/conlog/index.js",
  "exports": {
    ".": "./dist/conlog/index.js",
    "./*": "./dist/conlog/*.js"
  },
  "files": [
    "dist/conlog"
  ]
}
